# Dependencies
node_modules/
venv/
__pycache__/
*.pyc

# Build outputs
smart-waste-frontend/dist/
smart-waste-frontend/.vite/

# Environment variables — NEVER commit real .env files
.env
.env.local

# Database
*.db
*.sqlite

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Cache
.cache/
.parcel-cache/

# Generated reports (runtime output, not source)
backend/generated_reports/

# NOTE: backend/dataset/ and backend/ml/*.pkl are intentionally NOT ignored
# They must be committed so the deployed backend on Render can access them.

# ─────────────────────────────────────────────────────────────────────────────
# Smart Waste Management — Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────

# ── Flask Configuration ───────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production

# ── MongoDB Configuration ─────────────────────────────────────────────────────
# For local MongoDB:
# MONGO_URI=mongodb://localhost:27017/smart_waste_db
#
# For MongoDB Atlas (replace with your connection string):
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/smart_waste_db?retryWrites=true&w=majority

# ── JWT Configuration ─────────────────────────────────────────────────────────
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_EXPIRY_HOURS=24

# ── Frontend URL (for CORS) ───────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Dataset & Model Paths (relative to backend/ directory) ───────────────────
DATASET_PATH=dataset/Waste_Management_and_Recycling_India.csv
MODEL_PATH=ml/waste_model.pkl

# ── Optional: Email Configuration (for future email notifications) ─────────────
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_EMAIL=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# ── Optional: API Rate Limiting ───────────────────────────────────────────────
# RATE_LIMIT_PER_MINUTE=60